&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#008000;font-weight:bold"&gt;&amp;lt;artifactId&amp;gt;&lt;/span&gt;ceresdb-all&lt;span style="color:#008000;font-weight:bold"&gt;&amp;lt;/artifactId&amp;gt;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#008000;font-weight:bold"&gt;&amp;lt;version&amp;gt;&lt;/span&gt;${CERESDB.VERSION}&lt;span style="color:#008000;font-weight:bold"&gt;&amp;lt;/version&amp;gt;&lt;/span&gt;
