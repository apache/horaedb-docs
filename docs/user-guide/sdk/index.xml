&lt;pre tabindex="0" style=";-moz-tab-size:4;-o-tab-size:4;tab-size:4;"&gt;&lt;code class="language-go" data-lang="go"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#bbb"&gt;	&lt;/span&gt;client,&lt;span style="color:#bbb"&gt; &lt;/span&gt;err&lt;span style="color:#bbb"&gt; &lt;/span&gt;&lt;span style="color:#666"&gt;:=&lt;/span&gt;&lt;span style="color:#bbb"&gt; &lt;/span&gt;horaedb.&lt;span style="color:#00f"&gt;NewClient&lt;/span&gt;(endpoint,&lt;span style="color:#bbb"&gt; &lt;/span&gt;horaedb.Direct,&lt;span style="color:#bbb"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#bbb"&gt;		&lt;/span&gt;horaedb.&lt;span style="color:#00f"&gt;WithDefaultDatabase&lt;/span&gt;(&lt;span style="color:#ba2121"&gt;&amp;#34;public&amp;#34;&lt;/span&gt;),&lt;span style="color:#bbb"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#bbb"&gt;	&lt;/span&gt;)&lt;span style="color:#bbb"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;table&gt;
 &lt;thead&gt;
 &lt;tr&gt;
 &lt;th&gt;option name&lt;/th&gt;
 &lt;th&gt;description&lt;/th&gt;
 &lt;/tr&gt;
 &lt;/thead&gt;
 &lt;tbody&gt;
 &lt;tr&gt;
 &lt;td&gt;defaultDatabase&lt;/td&gt;
 &lt;td&gt;using database, database can be overwritten by ReqContext in single &lt;code&gt;Write&lt;/code&gt; or &lt;code&gt;SQLRequest&lt;/code&gt;&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;RPCMaxRecvMsgSize&lt;/td&gt;
 &lt;td&gt;configration for grpc &lt;code&gt;MaxCallRecvMsgSize&lt;/code&gt;, default 1024 _ 1024 _ 1024&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;RouteMaxCacheSize&lt;/td&gt;
 &lt;td&gt;If the maximum number of router cache size, router client whill evict oldest if exceeded, default is 10000&lt;/td&gt;
 &lt;/tr&gt;
 &lt;/tbody&gt;
