&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#bbb"&gt; &lt;/span&gt;enable_ttl&lt;span style="color:#666"&gt;=&lt;/span&gt;&lt;span style="color:#ba2121"&gt;&amp;#39;true&amp;#39;&lt;/span&gt;,&lt;span style="color:#bbb"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#bbb"&gt; &lt;/span&gt;num_rows_per_row_group&lt;span style="color:#666"&gt;=&lt;/span&gt;&lt;span style="color:#ba2121"&gt;&amp;#39;8192&amp;#39;&lt;/span&gt;,&lt;span style="color:#bbb"&gt;
