&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#bbb"&gt;&lt;/span&gt;)&lt;span style="color:#bbb"&gt; &lt;/span&gt;ENGINE&lt;span style="color:#666"&gt;=&lt;/span&gt;Analytic&lt;span style="color:#bbb"&gt; &lt;/span&gt;&lt;span style="color:#008000;font-weight:bold"&gt;WITH&lt;/span&gt;&lt;span style="color:#bbb"&gt; &lt;/span&gt;(&lt;span style="color:#bbb"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#bbb"&gt; &lt;/span&gt;arena_block_size&lt;span style="color:#666"&gt;=&lt;/span&gt;&lt;span style="color:#ba2121"&gt;&amp;#39;2097152&amp;#39;&lt;/span&gt;,&lt;span style="color:#bbb"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#bbb"&gt; &lt;/span&gt;compaction_strategy&lt;span style="color:#666"&gt;=&lt;/span&gt;&lt;span style="color:#ba2121"&gt;&amp;#39;default&amp;#39;&lt;/span&gt;,&lt;span style="color:#bbb"&gt;
